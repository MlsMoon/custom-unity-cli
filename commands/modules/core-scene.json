{
  "schemaVersion": "cucli.command-registry-module/v1",
  "module": "core-scene",
  "groups": [
    {
      "name": "object",
      "summary": "GameObject 与组件：创建、修改、删除、复制、相对移动、朝向、查找，以及组件的增删改查与检视。",
      "requiresEditor": true,
      "requiredMode": "any",
      "mutatesProject": true,
      "mayReloadDomain": false,
      "optionalPackage": null,
      "effects": [
        "editor.scene.read",
        "editor.scene.write",
        "project.assets.write"
      ],
      "surface": "core",
      "actions": [
        {
          "name": "create",
          "summary": "创建 GameObject（空物体 / primitive / prefab 实例），可设父节点、transform、tag、layer、组件。"
        },
        {
          "name": "modify",
          "summary": "修改目标 GameObject：改名、父节点、transform、tag、layer、激活状态、静态标记、组件增删与属性。"
        },
        {
          "name": "delete",
          "summary": "删除全部同名匹配的 GameObject（需要 force: true 确认，data 里报告删除数量）。"
        },
        {
          "name": "duplicate",
          "summary": "复制目标 GameObject，可设置新名、世界位置、世界偏移与父节点。"
        },
        {
          "name": "move_relative",
          "summary": "相对参考物体沿指定方向移动目标，支持世界轴或参考物体本地轴。"
        },
        {
          "name": "look_at",
          "summary": "让目标朝向一个坐标或另一个 GameObject。"
        },
        {
          "name": "find",
          "summary": "按 searchMethod 分页查找 GameObject（by_name / by_tag / by_layer / by_component / by_path / by_id）。"
        },
        {
          "name": "list",
          "summary": "列出目标 GameObject 上的全部组件（受 maxItems / maxDepth 限制）。"
        },
        {
          "name": "add",
          "summary": "给目标 GameObject 添加一个组件，可同时写入初始属性。"
        },
        {
          "name": "remove",
          "summary": "移除目标 GameObject 上的一个组件（可按 componentIndex 指定同类型实例）。"
        },
        {
          "name": "set-property",
          "summary": "写入组件属性：批量 properties 对象，或 property + value 单字段。"
        },
        {
          "name": "get-property",
          "summary": "读取单个组件属性，输出受 CucliDescribe 约束。"
        },
        {
          "name": "inspect",
          "summary": "检视组件（或 GameObject 本身）的成员清单，可选读取成员值。"
        }
      ],
      "parametersSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "create",
              "modify",
              "delete",
              "duplicate",
              "move_relative",
              "look_at",
              "find",
              "list",
              "add",
              "remove",
              "set-property",
              "get-property",
              "inspect"
            ],
            "default": "create"
          },
          "target": {
            "type": "string",
            "description": "name / 层级路径 / instanceID；create 之外多数 action 需要。"
          },
          "name": {
            "type": "string",
            "description": "action=create：新物体名；action=modify：缺 target 时作为查找名。"
          },
          "newName": {
            "type": "string",
            "description": "action=modify / duplicate：改名后的新名。"
          },
          "searchMethod": {
            "type": "string",
            "enum": [
              "by_id_or_name_or_path",
              "by_id",
              "by_name",
              "by_path",
              "by_tag",
              "by_layer",
              "by_component"
            ],
            "description": "寻址方式；find 默认 by_name。"
          },
          "searchTerm": {
            "type": "string",
            "aliases": [
              "search_term",
              "target",
              "name"
            ],
            "description": "action=find：搜索词（target / name 为兼容别名）。"
          },
          "includeInactive": {
            "type": "boolean",
            "default": false,
            "description": "action=find：是否包含 inactive（resolver 始终包含）。"
          },
          "parent": {
            "description": "action=create / modify / duplicate：父物体引用；空串或 null 表示移到根。"
          },
          "position": {
            "description": "action=create / modify 写 localPosition；duplicate 写世界 position。"
          },
          "rotation": {
            "description": "action=create / modify：localEulerAngles [x,y,z]。"
          },
          "scale": {
            "description": "action=create / modify：localScale [x,y,z]。"
          },
          "tag": {
            "type": "string"
          },
          "layer": {
            "type": "string",
            "description": "层名或 0-31 的层索引。"
          },
          "setActive": {
            "type": "boolean",
            "description": "action=modify：设置 activeSelf。"
          },
          "isStatic": {
            "type": "boolean",
            "description": "action=modify：设置 StaticEditorFlags。"
          },
          "primitiveType": {
            "type": "string",
            "aliases": [
              "primitive_type",
              "primitive"
            ],
            "description": "action=create：PrimitiveType 枚举名。也接受 --primitive。"
          },
          "prefabPath": {
            "type": "string",
            "description": "action=create：实例化来源 prefab；saveAsPrefab 时作为保存目标。"
          },
          "saveAsPrefab": {
            "type": "boolean",
            "default": false,
            "description": "action=create：把新物体存为 prefab。"
          },
          "componentsToAdd": {
            "type": "array",
            "items": {},
            "description": "元素为类型名，或 { typeName, properties }。"
          },
          "componentsToRemove": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "componentProperties": {
            "description": "{ 组件名: { 属性: 值 } }，也接受 JSON 字符串。"
          },
          "componentType": {
            "type": "string",
            "aliases": [
              "component_type",
              "component",
              "type"
            ],
            "description": "组件类型名。也接受 --component。"
          },
          "componentIndex": {
            "type": "integer",
            "description": "同类型多实例时按 0 基索引操作。"
          },
          "properties": {
            "description": "action=add / set-property：{ 属性: 值 } 对象或 JSON 字符串。"
          },
          "property": {
            "type": "string",
            "description": "action=set-property / get-property：单个属性名或属性路径（如 a.b[0].c）。"
          },
          "value": {
            "description": "action=set-property：与 property 配对的单属性值。"
          },
          "offset": {
            "description": "action=duplicate：世界偏移；action=move_relative：相对偏移。"
          },
          "referenceObject": {
            "description": "action=move_relative：参考物体引用（必填）。"
          },
          "direction": {
            "type": "string",
            "enum": [
              "right",
              "left",
              "up",
              "down",
              "forward",
              "front",
              "back",
              "backward",
              "behind"
            ],
            "default": "forward"
          },
          "distance": {
            "type": "number",
            "default": 1
          },
          "worldSpace": {
            "type": "boolean",
            "default": true,
            "description": "action=move_relative：true 用世界轴，false 用参考物体本地轴。"
          },
          "lookAtTarget": {
            "description": "action=look_at：[x,y,z] 或 GameObject 引用。"
          },
          "lookAtUp": {
            "description": "action=look_at：上方向，默认 [0,1,0]。"
          },
          "force": {
            "type": "boolean",
            "default": false,
            "description": "action=delete：确认删除。"
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 50
          },
          "cursor": {
            "type": [
              "string",
              "integer"
            ],
            "description": "0 基游标。"
          },
          "pageNumber": {
            "type": "integer",
            "minimum": 1
          },
          "maxItems": {
            "type": "integer",
            "default": 64,
            "description": "list / get-property / inspect 的输出上限。"
          },
          "maxDepth": {
            "type": "integer",
            "default": 4
          },
          "maxStringLength": {
            "type": "integer",
            "default": 4096
          },
          "includeValues": {
            "type": "boolean",
            "default": false,
            "description": "action=inspect：是否读取成员值。"
          },
          "includeNoisy": {
            "type": "boolean",
            "default": false,
            "description": "action=inspect：是否包含 hideFlags 之类的噪声成员。"
          }
        }
      }
    },
    {
      "name": "prefab",
      "summary": "Prefab 资产：从场景物体创建、读取信息与层级、在隔离上下文中修改内容，以及 Prefab Stage 的打开/保存/关闭。",
      "requiresEditor": true,
      "requiredMode": "any",
      "mutatesProject": true,
      "mayReloadDomain": false,
      "optionalPackage": null,
      "effects": [
        "project.assets.read",
        "project.assets.write",
        "editor.scene.write"
      ],
      "surface": "core",
      "actions": [
        {
          "name": "create_from_gameobject",
          "summary": "把场景或 Prefab Stage 中的物体保存为 prefab 资产（需要 force 才能覆盖已存在资产）。"
        },
        {
          "name": "get_info",
          "summary": "读取 prefab 资产信息：guid、类型、根物体、组件类型、子物体数、是否 Variant。"
        },
        {
          "name": "get_hierarchy",
          "summary": "分页列出 prefab 内部的全部节点（路径为 A/B/C 形式）。"
        },
        {
          "name": "modify_contents",
          "summary": "在 LoadPrefabContents 事务中修改 prefab 内容：改名、transform、父节点、组件、增删子物体。"
        },
        {
          "name": "open_prefab_stage",
          "summary": "在 Prefab Stage（可交互编辑态）中打开 prefab。"
        },
        {
          "name": "save_prefab_stage",
          "summary": "保存当前 Prefab Stage 的内容。"
        },
        {
          "name": "close_prefab_stage",
          "summary": "退出 Prefab Stage，可选先保存。"
        }
      ],
      "parametersSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "create_from_gameobject",
              "get_info",
              "get_hierarchy",
              "modify_contents",
              "open_prefab_stage",
              "save_prefab_stage",
              "close_prefab_stage"
            ],
            "default": "create_from_gameobject"
          },
          "prefabPath": {
            "type": "string",
            "description": "prefab 资产路径，必须位于 Assets/ 下；path 为别名。"
          },
          "target": {
            "type": "string",
            "description": "create 时是场景/Prefab Stage 内的源物体；modify 时是 prefab 内部 A/B/C 路径或名称。"
          },
          "name": {
            "type": "string",
            "description": "create 时是 target 的别名；modify 时是重命名的新名。"
          },
          "searchInactive": {
            "type": "boolean",
            "default": false,
            "description": "action=create_from_gameobject：源物体查找是否包含 inactive。"
          },
          "allowOverwrite": {
            "type": "boolean",
            "default": false,
            "description": "action=create_from_gameobject：force 的 MCP 别名。"
          },
          "unlinkIfInstance": {
            "type": "boolean",
            "default": false,
            "description": "action=create_from_gameobject：先 UnpackPrefabInstance(Completely)。"
          },
          "force": {
            "type": "boolean",
            "default": false,
            "description": "action=create_from_gameobject：覆盖已存在的 prefab 资产。"
          },
          "setActive": {
            "type": "boolean",
            "description": "action=modify_contents：设置 activeSelf。"
          },
          "tag": {
            "type": "string"
          },
          "layer": {
            "type": "string",
            "description": "层名。"
          },
          "position": {
            "description": "action=modify_contents / createChild：localPosition [x,y,z]。"
          },
          "rotation": {
            "description": "action=modify_contents / createChild：localEulerAngles [x,y,z]。"
          },
          "scale": {
            "description": "action=modify_contents / createChild：localScale [x,y,z]。"
          },
          "parent": {
            "type": "string",
            "description": "action=modify_contents：prefab 内新父物体名/路径；空串表示置根。"
          },
          "componentsToAdd": {
            "type": "array",
            "items": {},
            "description": "元素为类型名或 { typeName, properties }。"
          },
          "componentsToRemove": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "componentProperties": {
            "description": "{ 组件名: { 属性: 值 } }；任一失败则整体不保存。"
          },
          "createChild": {
            "description": "子物体定义对象或对象数组（name / parent / sourcePrefabPath / primitiveType / transform / componentsToAdd / tag / layer / setActive）。"
          },
          "deleteChild": {
            "description": "相对 target 的子物体路径：字符串、字符串数组或 { name }。"
          },
          "saveBeforeClose": {
            "type": "boolean",
            "default": false,
            "description": "action=close_prefab_stage：关闭前先保存。"
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 100
          },
          "cursor": {
            "type": [
              "string",
              "integer"
            ],
            "description": "0 基游标。"
          },
          "pageNumber": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    {
      "name": "scene",
      "summary": "场景管理：创建、加载、保存、关闭、切换激活、层级浏览、Build Settings、截图、框选与校验。",
      "requiresEditor": true,
      "requiredMode": "any",
      "mutatesProject": true,
      "mayReloadDomain": false,
      "optionalPackage": null,
      "effects": [
        "project.assets.read",
        "project.assets.write",
        "editor.scene.read",
        "editor.scene.write"
      ],
      "surface": "core",
      "actions": [
        {
          "name": "create",
          "summary": "新建场景（empty / default / 3d_basic / 2d_basic 模板，默认 Assets/Scenes/<name>.unity）。"
        },
        {
          "name": "load",
          "summary": "按 path / name / buildIndex 加载场景；当前场景有未保存改动时按 MCP 语义拒绝加载。"
        },
        {
          "name": "save",
          "summary": "保存指定或当前场景，可另存到新的 path。"
        },
        {
          "name": "get_hierarchy",
          "summary": "分页列出场景根节点或某个父物体的直接子级（含 inactive、组件类型、可选 transform）。"
        },
        {
          "name": "get_active",
          "summary": "报告当前活动场景的名称、路径、buildIndex、脏标记与根节点数量。"
        },
        {
          "name": "get_build_settings",
          "summary": "列出 EditorBuildSettings 中的场景（path / guid / enabled / buildIndex）。"
        },
        {
          "name": "screenshot",
          "summary": "截图（game_view 或 scene_view、相机/定位/包围盒批量环绕），写出 PNG 资产，可选内联 base64。"
        },
        {
          "name": "scene_view_frame",
          "summary": "在 SceneView 中框选目标物体或整个场景。"
        },
        {
          "name": "close_scene",
          "summary": "关闭已加载场景；只剩一个场景或场景有未保存改动时拒绝。"
        },
        {
          "name": "set_active_scene",
          "summary": "把某个已加载场景设为活动场景。"
        },
        {
          "name": "get_loaded_scenes",
          "summary": "列出全部已加载场景及其状态。"
        },
        {
          "name": "move_to_scene",
          "summary": "把一个根 GameObject 移动到另一个已加载场景。"
        },
        {
          "name": "validate",
          "summary": "校验活动场景中的 Missing Script 与丢失引用的 prefab，可选自动修复 Missing Script。"
        }
      ],
      "parametersSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "create",
              "load",
              "save",
              "get_hierarchy",
              "get_active",
              "get_build_settings",
              "screenshot",
              "scene_view_frame",
              "close_scene",
              "set_active_scene",
              "get_loaded_scenes",
              "move_to_scene",
              "validate"
            ],
            "default": "create"
          },
          "name": {
            "type": "string",
            "description": "action=create / save / load / close_scene / set_active_scene / move_to_scene：场景名。"
          },
          "path": {
            "type": "string",
            "description": "action=create / load / save：目录或 .unity 资产路径（Assets/ 下）。"
          },
          "buildIndex": {
            "type": "integer",
            "description": "action=load：Build Settings 索引，与 path/name 二选一。"
          },
          "additive": {
            "type": "boolean",
            "default": false,
            "description": "action=load：以 Additive 方式打开。"
          },
          "template": {
            "type": "string",
            "enum": [
              "empty",
              "default",
              "3d_basic",
              "2d_basic"
            ],
            "description": "action=create：场景模板。"
          },
          "force": {
            "type": "boolean",
            "default": false,
            "description": "action=create / load / close_scene：覆盖已有场景或丢弃未保存改动。"
          },
          "captureSource": {
            "type": "string",
            "enum": [
              "game_view",
              "scene_view"
            ],
            "default": "game_view"
          },
          "fileName": {
            "type": "string",
            "description": "action=screenshot：输出文件名（自动补 .png）。"
          },
          "superSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8,
            "default": 1
          },
          "includeImage": {
            "type": "boolean",
            "default": false,
            "description": "action=screenshot：是否内联 base64 图片。"
          },
          "maxResolution": {
            "type": "integer",
            "default": 640,
            "description": "action=screenshot：内联图片长边上限，0 表示默认 640。"
          },
          "outputFolder": {
            "type": "string",
            "description": "action=screenshot：输出目录，默认 Assets/Screenshots。"
          },
          "camera": {
            "type": "string",
            "description": "action=screenshot：Camera 的 name / hierarchy path / instanceID（scene_view 下禁止）。"
          },
          "batch": {
            "type": "string",
            "enum": [
              "surround",
              "orbit"
            ],
            "description": "action=screenshot：包围盒批量环绕截图。"
          },
          "viewTarget": {
            "description": "action=screenshot：聚焦目标（GO 引用或 [x,y,z]）。"
          },
          "viewPosition": {
            "description": "action=screenshot：临时相机位置 [x,y,z]。"
          },
          "viewRotation": {
            "description": "action=screenshot：临时相机欧拉角 [x,y,z]。"
          },
          "orbitAngles": {
            "type": "integer",
            "minimum": 1,
            "maximum": 36,
            "default": 8
          },
          "orbitElevations": {
            "description": "action=screenshot(batch=orbit)：仰角列表，默认 [0,30,-15]。"
          },
          "orbitDistance": {
            "type": "number",
            "description": "action=screenshot(batch=orbit)：相机距中心距离。"
          },
          "orbitFov": {
            "type": "number",
            "minimum": 10,
            "maximum": 120,
            "default": 60
          },
          "sceneViewTarget": {
            "description": "action=scene_view_frame：要框选的物体（GO 引用）。"
          },
          "parent": {
            "type": "string",
            "description": "action=get_hierarchy：列出该物体的直接子级；省略则列出场景根节点。"
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 50
          },
          "cursor": {
            "type": [
              "string",
              "integer"
            ],
            "description": "action=get_hierarchy / get_build_settings / get_loaded_scenes：0 基游标。"
          },
          "pageNumber": {
            "type": "integer",
            "minimum": 1
          },
          "maxNodes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5000,
            "default": 1000
          },
          "maxDepth": {
            "type": "integer",
            "default": 4,
            "description": "action=get_hierarchy：当前分页模式只返回一层，仅为兼容回显。"
          },
          "maxChildrenPerNode": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2000,
            "default": 200
          },
          "includeTransform": {
            "type": "boolean",
            "default": false
          },
          "sceneName": {
            "type": "string",
            "description": "action=close_scene / set_active_scene / move_to_scene：已加载场景名。"
          },
          "scenePath": {
            "type": "string",
            "description": "action=close_scene / set_active_scene / move_to_scene：已加载场景路径。"
          },
          "removeScene": {
            "type": "boolean",
            "default": false,
            "description": "action=close_scene：true 从内存移除，false 仅卸载。"
          },
          "target": {
            "type": "string",
            "description": "action=move_to_scene：根 GameObject 的 name / path / instanceID。"
          },
          "autoRepair": {
            "type": "boolean",
            "default": false,
            "description": "action=validate：自动移除 Missing Script。"
          },
          "maxItems": {
            "type": "integer",
            "default": 64
          }
        }
      }
    }
  ]
}
